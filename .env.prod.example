# GHCR image
IMAGE_REPOSITORY=ghcr.io/YOUR_GITHUB_OWNER/ejib-backend
IMAGE_TAG=latest

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# RDS MySQL
EJIB_DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/ejib_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=true&allowPublicKeyRetrieval=false
EJIB_DB_USERNAME=ejib
EJIB_DB_PASSWORD=CHANGE_ME

# JWT
JWT_ISSUER=ejib-api
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600

# Kakao OAuth
KAKAO_REST_API_KEY=CHANGE_ME
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://YOUR_DOMAIN.duckdns.org/oauth/kakao/callback
KAKAO_FRONTEND_SUCCESS_URI=https://YOUR_FRONTEND_DOMAIN/oauth/kakao/success
KAKAO_FRONTEND_FAILURE_URI=https://YOUR_FRONTEND_DOMAIN/login
KAKAO_STATE_COOKIE_SECURE=true

# Google Gemini
GEMINI_API_KEY=CHANGE_ME

# Cloudinary
CLOUDINARY_NAME=CHANGE_ME
CLOUDINARY_KEY=CHANGE_ME
CLOUDINARY_SECRET=CHANGE_ME

# Optional
SWAGGER_ENABLED=false
SERVER_TOMCAT_THREADS_MAX=200
SERVER_TOMCAT_THREADS_MIN_SPARE=10
